# MONGODB URI
# Format: mongodb://username:password@host:port/database
MONGODB_URI=mongodb://localhost:27017/kavach

# PORT
PORT=5000

# Frontend URL (for CORS and redirect URLs)
FRONTEND_URL=http://localhost:5173

# JWT Secret
JWT_SECRET=kavach-super-secret-key-change-in-production

# Socket.IO CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,exp://10.0.2.2:8081

# bcrypt salt rounds
BCRYPT_SALT_ROUNDS=12

# Optional: Cloudinary or other storage config
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=