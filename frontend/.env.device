# Physical Android Device Environment Configuration
# A real phone cannot use 10.0.2.2 (that is the emulator's alias for the host
# loopback); it must reach the laptop over the local network instead.
#
# The laptop's current Wi-Fi IPv4 is 10.155.160.233 and the backend listens on
# 0.0.0.0:5000, so the phone reaches it at http://10.155.160.233:5000.
# NOTE: this is a DHCP address — if the laptop is reassigned a new one, update
# this file (and android/app/src/main/res/xml/network_security_config.xml),
# then rebuild with `npm run build:device`.

VITE_API_URL=http://10.155.160.233:5000
